{
  "name": "autumn-haze-0590",
  "compatibility_date": "2026-08-20",
  "main": "worker/index.js",
  // Custom domains attached to this Worker. Declared here (rather than left
  // dashboard-only) so `wrangler deploy` stops reporting local/remote config
  // drift and cannot silently drop them on a future deploy.
  "routes": [
    { "pattern": "ggcconstrucciones.cl", "custom_domain": true },
    { "pattern": "www.ggcconstrucciones.cl", "custom_domain": true }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  }
}
